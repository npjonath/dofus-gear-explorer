{
  "name": "dofus-gear-explorer",
  "private": true,
  "version": "0.3.0",
  "description": "Explore Dofus equipment and build or search gear sets from live game data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npjonath/dofus-gear-explorer.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"pnpm --filter @dde/api dev\" \"pnpm --filter @dde/web dev\"",
    "dev:desktop": "pnpm --filter @dde/api build && pnpm --filter @dde/desktop dev",
    "dev:api": "pnpm --filter @dde/api dev",
    "dev:web": "pnpm --filter @dde/web dev",
    "lint": "oxlint --deny-warnings && pnpm --filter @dde/api lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @dde/api build:targets && pnpm --filter @dde/desktop dist",
    "build:desktop:mac": "pnpm --filter @dde/api build:targets mac-arm64 mac-x64 && pnpm --filter @dde/desktop dist:mac",
    "build:desktop:win": "pnpm --filter @dde/api build:targets win-x64 && pnpm --filter @dde/desktop dist:win",
    "build:desktop:linux": "pnpm --filter @dde/api build:targets linux-x64 && pnpm --filter @dde/desktop dist:linux",
    "data:sync": "pnpm --filter @dde/api data:sync",
    "data:check": "pnpm --filter @dde/api data:check",
    "notices": "node scripts/third-party-notices.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "oxlint": "1.90.0",
    "typescript": "^7.0.2"
  }
}
