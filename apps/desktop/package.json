{
  "name": "@dde/desktop",
  "private": true,
  "version": "0.3.0",
  "description": "Electron shell of Dofus Gear Explorer. Runs the Go API as a local sidecar.",
  "author": "Dofus Gear Explorer contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npjonath/dofus-gear-explorer.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@dde/app": "workspace:*",
    "electron-updater": "6.8.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "app.dofusgearexplorer.desktop",
    "productName": "Dofus Gear Explorer",
    "artifactName": "Dofus-Gear-Explorer-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "../api/bin/${os}-${arch}/",
        "to": "bin/",
        "filter": [
          "dde-api*"
        ]
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "executableName": "dofus-gear-explorer"
    },
    "copyright": "Copyright © 2026 Dofus Gear Explorer contributors. Unofficial tool, not affiliated with Ankama.",
    "nsis": {
      "artifactName": "Dofus-Gear-Explorer-${version}-${os}-${arch}-setup.${ext}",
      "shortcutName": "Dofus Gear Explorer"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ]
  }
}
